###
### Add host override
### rr: A, AAAA (server is the IP), MX (mx + mxprio), TXT (txtdata)
###
POST {{baseUrl}}/api/unbound/settings/add_host_override
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
Accept: application/json

{
  "host" : {
    "enabled": "1",
    "hostname": "test",
    "domain": "fest.local",
    "rr": "A",
    "server": "1.1.1.1",
    "ttl": "300",
    "addptr": "1",
    "description": "created by opn"
  }
}

###
### Update host override (only the given fields are changed)
###
POST {{baseUrl}}/api/unbound/settings/set_host_override/84364c29-dce8-4d81-9681-a7e789e8c035
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
Accept: application/json

{
  "host" : {
    "server": "1.1.1.2"
  }
}

###
### Get host override (without uuid you get the defaults / available options)
###
GET {{baseUrl}}/api/unbound/settings/get_host_override/84364c29-dce8-4d81-9681-a7e789e8c035
Authorization: Basic {{username}} {{password}}
Accept: application/json

###
### Delete host override
###
POST {{baseUrl}}/api/unbound/settings/del_host_override/84364c29-dce8-4d81-9681-a7e789e8c035
Authorization: Basic {{username}} {{password}}
Accept: application/json


###
### Search host override
###
GET {{baseUrl}}/api/unbound/settings/search_host_override
Authorization: Basic {{username}} {{password}}
Accept: application/json


###
### Search host override with search phrase
###
GET {{baseUrl}}/api/unbound/settings/search_host_override?searchPhrase=test.local
Authorization: Basic {{username}} {{password}}
Accept: application/json

###
### Service status
###
GET {{baseUrl}}/api/unbound/service/status
Authorization: Basic {{username}} {{password}}
Accept: application/json

###
### Service reconfigure (apply host override changes)
###
POST {{baseUrl}}/api/unbound/service/reconfigure
Authorization: Basic {{username}} {{password}}
Accept: application/json

###
### Service restart
###
POST {{baseUrl}}/api/unbound/service/restart
Authorization: Basic {{username}} {{password}}
Accept: application/json
