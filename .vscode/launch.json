{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Real",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/opn.go",
            "envFile": ".vscode/.env"
        },
        {
            "name": "Launch Container",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/opn.go",
            "args": [
                "unbound",
                "service",
                "status"
            ],
            "env": {
                "OPN_URL": "https://opnsense-dev",
                "OPN_NOSSLVERIFY": "1"
            },
            "envFile": "/home/vscode/.vscopnsense-env"
        }
    ]
}
