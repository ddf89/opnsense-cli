{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Refresh Keys",
            "type": "shell",
            "command": "rm -f /home/vscode/.opnsense-env ; rm -f /home/vscode/.vscopnsense-env ; sudo bash ${workspaceFolder}/.devcontainer/wait-for-keys.sh",
            "problemMatcher": []
        },
        {
            "label": "Build opn",
            "detail": "go build into dist/opn for the devcontainer's platform",
            "type": "shell",
            "command": "rm -f dist/* ; GOARCH=amd64 GOOS=linux go build -o ${workspaceFolder}/dist/opn-linux-amd64 . ; GOARCH=arm64 GOOS=darwin go build -o ${workspaceFolder}/dist/opn-darwin-aarch-64 .",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$go"
        }
    ]
}
