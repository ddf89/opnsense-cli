{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Refresh Keys",
            "type": "shell",
            "command": "rm -f /home/vscode/.opnsense-env ; rm -f /home/vscode/.vscopnsense-env ; sudo bash ${workspaceFolder}/.devcontainer/wait-for-keys.sh",
            "problemMatcher": []
        },
        {
            "label": "Build opn",
            "detail": "build dist/opn-<os>-<arch> for linux, macos and windows on amd64 and arm64 (release names, version from git describe) and dist/SHA256SUMS",
            "type": "shell",
            "command": "set -e; rm -f dist/*; mkdir -p dist; version=$(git describe --tags --always --dirty 2>/dev/null || echo dev); for platform in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64 windows/arm64; do os=$(dirname $platform); arch=$(basename $platform); name=$os; [ $os = darwin ] && name=macos; ext=; [ $os = windows ] && ext=.exe; echo \"building dist/opn-$name-$arch$ext ($version)\"; CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath -ldflags \"-X opnsense-cli/cli.Version=$version\" -o dist/opn-$name-$arch$ext .; done; (cd dist && sha256sum opn-* > SHA256SUMS && cat SHA256SUMS)",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$go"
        }
    ]
}
